# ── Google Gemini API ─────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
# NEVER commit a real key. This file is safe to commit as a template only.
GEMINI_API_KEY=your-gemini-api-key-here

# Model name MUST come from running:
#   python backend/scripts/list_gemini_models.py
# Do NOT guess or hardcode a model name — availability depends on your key and region.
GEMINI_MODEL=

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_SECRET_KEY=change-this-to-a-random-string-before-demo
FLASK_ENV=development
FLASK_DEBUG=1

# ── Database (Supabase PostgreSQL / SQLite fallback) ──────────────────────────
# Supabase PostgreSQL (Production / Demo):
# Obtain from Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
#
# Option A: Transaction Pooler (Recommended for IPv4 / cloud):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
#
# Option B: Direct Connection (Session Mode):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Important: If your database password contains special characters (like @, %, #, etc.),
# you MUST URL-encode them (e.g., '@' becomes '%40').
#
# Local SQLite Fallback (default if DATABASE_URL is unset):
DATABASE_URL=sqlite:///instance/creatorconnect.db

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
